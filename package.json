{
  "name": "workouts",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "start": "pnpm --filter @workouts/mobile start",
    "ios": "pnpm --filter @workouts/mobile ios",
    "android": "pnpm --filter @workouts/mobile android",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "bundle": "pnpm --filter @workouts/mobile exec expo export --platform ios",
    "seed:build": "pnpm --filter @workouts/seed-exercises build",
    "db:generate": "pnpm --filter @workouts/schema generate"
  },
  "devDependencies": {
    "react-native-web": "^0.21.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
